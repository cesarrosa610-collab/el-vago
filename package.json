{
  "name": "el-vago-mvp-local-playable",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "preflight": "node scripts/preflight.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "beta:check": "npm run preflight && npm run smoke:test && npm run typecheck && npm run test && npm run build",
    "offline:e2e": "node scripts/offline-e2e.mjs",
    "beta:offline": "npm run preflight && npm run smoke:test && npm run offline:e2e",
    "db:postgres:generate": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:postgres:push": "prisma db push --schema prisma/schema.postgres.prisma",
    "postinstall": "prisma generate --schema prisma/schema.postgres.prisma",
    "vercel-build": "prisma generate --schema prisma/schema.postgres.prisma && prisma db push --schema prisma/schema.postgres.prisma && npm run semilla && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
  "@types/node": "^22.0.0",
  "@types/react": "^19.0.0",
  "prisma": "^6.14.0",
  "tsx": "^4.20.3",
  "typescript": "^5.9.2",
  "vitest": "^3.2.4"
},
"version": "2.3.0"
}
